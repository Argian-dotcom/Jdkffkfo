local AUTOEXEC_FOLDERS = { "autoexecute", "autoexec", "AutoExec", "auto-exec" }

local AutoExecConfig = {
	Enabled = true,
	Url = "https://raw.githubusercontent.com/script-Ez/Scripts/main/Low.lua",
	Folders = AUTOEXEC_FOLDERS,
	FileName = "spsl_autoexec.lua",
	PayloadFileName = "spsl_payload.lua",
}

local function resolveAutoExecUrl(overrideUrl)
	if type(overrideUrl) == "string" and overrideUrl ~= "" then
		return overrideUrl
	end
	local envCfg = getgenv().SpslAutoExecConfig or getgenv().SpslConfig or getgenv().Config
	if type(envCfg) == "table" then
		local candidate = envCfg.Url or envCfg.url or envCfg.LoaderUrl or envCfg.AutoExecUrl
		if type(candidate) == "string" and candidate ~= "" then
			return candidate
		end
	end
	if type(getgenv().SpslLoaderUrl) == "string" and getgenv().SpslLoaderUrl ~= "" then
		return getgenv().SpslLoaderUrl
	end
	if type(AutoExecConfig.Url) == "string" and AutoExecConfig.Url ~= "" then
		return AutoExecConfig.Url
	end
	return ""
end

local function serializeLua(val, depth)
	depth = depth or 0
	if depth > 12 then return "nil" end
	local t = type(val)
	if t == "nil" then
		return "nil"
	elseif t == "boolean" then
		return val and "true" or "false"
	elseif t == "number" then
		if val ~= val or val == math.huge or val == -math.huge then return "0" end
		return tostring(val)
	elseif t == "string" then
		return string.format("%q", val)
	elseif t == "table" then
		local parts = {}
		for k, v in pairs(val) do
			if type(v) ~= "function" and type(v) ~= "thread" and type(v) ~= "userdata" then
				local keyStr
				if type(k) == "string" and k:match("^[%a_][%w_]*$") then
					keyStr = k .. " = "
				else
					keyStr = "[" .. serializeLua(k, depth + 1) .. "] = "
				end
				parts[#parts + 1] = keyStr .. serializeLua(v, depth + 1)
			end
		end
		return "{" .. table.concat(parts, ", ") .. "}"
	end
	return "nil"
end

local function buildAutoExecScript(url, args)
	local escapedUrl = string.format("%q", tostring(url or ""))
	local serializedArgs = serializeLua(args or {})

	return [[
if getgenv().SpslMainAutoExecRan then return end
getgenv().SpslMainAutoExecRan = true

task.spawn(function()
	if not game:IsLoaded() then
		game.Loaded:Wait()
	end

	local args = ]] .. serializedArgs .. [[
	local cfgUrl = ]] .. escapedUrl .. [[

	local envCfg = getgenv().SpslAutoExecConfig or getgenv().SpslConfig or getgenv().Config
	if type(envCfg) == "table" then
		local u = envCfg.Url or envCfg.url or envCfg.LoaderUrl or envCfg.AutoExecUrl
		if type(u) == "string" and u ~= "" then
			cfgUrl = u
		end
	elseif type(getgenv().SpslLoaderUrl) == "string" and getgenv().SpslLoaderUrl ~= "" then
		cfgUrl = getgenv().SpslLoaderUrl
	end

	local src
	if type(cfgUrl) == "string" and cfgUrl ~= "" then
		local okFetch, body = pcall(function()
			return game:HttpGet(cfgUrl)
		end)
		if okFetch and type(body) == "string" and #body > 0 then
			src = body
			getgenv().SpslMainSource = src
			if type(writefile) == "function" then
				pcall(writefile, ]] .. string.format("%q", AutoExecConfig.PayloadFileName) .. [[, src)
			end
		end
	end

	if (type(src) ~= "string" or #src == 0) and type(readfile) == "function" and type(isfile) == "function" then
		for _, path in ipairs({]] .. string.format("%q", AutoExecConfig.PayloadFileName) .. [[, "spsl_main.lua", "main.lua"}) do
			local ok, exists = pcall(isfile, path)
			if ok and exists then
				local rOk, raw = pcall(readfile, path)
				if rOk and type(raw) == "string" and #raw > 0 then
					src = raw
					break
				end
			end
		end
	end

	if (type(src) ~= "string" or #src == 0) and type(getgenv().SpslMainSource) == "string" then
		src = getgenv().SpslMainSource
	end

	if type(src) ~= "string" or #src == 0 then return end

	local fn = loadstring(src)
	if type(fn) == "function" then
		local runner = fn()
		if type(runner) == "function" then
			runner(args[1], args[2], args[3], args[4], args[5], args[6], args[7])
		end
	end
end)
]]
end

local function installMainAutoExec(args, rawSource, overrideUrl)
	local envCfg = getgenv().SpslAutoExecConfig or getgenv().SpslConfig or getgenv().Config
	if type(envCfg) == "table" and envCfg.Enabled == false then
		return
	end
	if AutoExecConfig.Enabled == false then
		return
	end

	local resolvedUrl = resolveAutoExecUrl(overrideUrl)

	local mainSource = rawSource
	if (type(mainSource) ~= "string" or #mainSource == 0) and resolvedUrl ~= "" then
		pcall(function()
			local fetched = game:HttpGet(resolvedUrl)
			if type(fetched) == "string" and #fetched > 0 then
				mainSource = fetched
			end
		end)
	end

	if (type(mainSource) ~= "string" or #mainSource == 0) and type(readfile) == "function" and type(isfile) == "function" then
		for _, path in ipairs({AutoExecConfig.PayloadFileName, "spsl_main.lua", "main.lua"}) do
			local ok, exists = pcall(isfile, path)
			if ok and exists then
				local rOk, raw = pcall(readfile, path)
				if rOk and type(raw) == "string" and #raw > 0 then
					mainSource = raw
					break
				end
			end
		end
	end

	if (type(mainSource) ~= "string" or #mainSource == 0) and type(getgenv().SpslMainSource) == "string" and #getgenv().SpslMainSource > 0 then
		mainSource = getgenv().SpslMainSource
	end

	if type(mainSource) == "string" and #mainSource > 0 then
		getgenv().SpslMainSource = mainSource
		if type(writefile) == "function" then
			pcall(writefile, AutoExecConfig.PayloadFileName, mainSource)
		end
	end

	local autoExecScript = buildAutoExecScript(resolvedUrl, args)

	local qot = (type(queueonteleport) == "function" and queueonteleport)
		or (type(queue_on_teleport) == "function" and queue_on_teleport)
		or (syn and type(syn.queue_on_teleport) == "function" and syn.queue_on_teleport)

	if qot then
		pcall(qot, autoExecScript)
	end

	if type(writefile) == "function" then
		pcall(writefile, AutoExecConfig.FileName, autoExecScript)
		local folders = (type(envCfg) == "table" and type(envCfg.Folders) == "table" and envCfg.Folders)
			or AutoExecConfig.Folders
		if type(isfolder) == "function" then
			for _, dir in ipairs(folders) do
				local ok, exists = pcall(isfolder, dir)
				if ok and exists then
					pcall(writefile, dir .. "/" .. AutoExecConfig.FileName, autoExecScript)
				end
			end
		end
	end
end

return {
	Config = AutoExecConfig,
	ResolveUrl = resolveAutoExecUrl,
	BuildScript = buildAutoExecScript,
	Install = installMainAutoExec,
}
